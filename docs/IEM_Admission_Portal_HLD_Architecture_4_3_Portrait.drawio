  <mxCell id="cli_web" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Applicant Web Portal&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #0284c7;&quot;&gt;(Responsive Web App / React)&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 5px 0; border: 0; border-top: 1px solid #38bdf8;&quot;&gt;• Student Registration &amp;amp; Secure Login&lt;br&gt;• Admission Form Submission &amp;amp; Preview&lt;br&gt;• Document Upload (Marksheets, ID, Photo)&lt;br&gt;• Online Fee Payment &amp;amp; Admit Letter Download" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;spacingTop=6;spacingBottom=6;fontSize=11;fillColor=#f0f9ff;strokeColor=#0284c7;strokeWidth=1.5;" vertex="1" parent="box_l1">
