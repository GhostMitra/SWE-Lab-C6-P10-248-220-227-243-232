  <mxCell id="data_s3" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Cloud Object Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #ea580c;&quot;&gt;(AWS S3 / Cloud Storage)&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 5px 0; border: 0; border-top: 1px solid #fb923c;&quot;&gt;• &lt;b&gt;Academic Docs:&lt;/b&gt; 10th &amp;amp; 12th Marksheet PDFs&lt;br&gt;• &lt;b&gt;Candidate Media:&lt;/b&gt; Passport Photos &amp;amp; Signatures&lt;br&gt;• &lt;b&gt;Verification Certs:&lt;/b&gt; Identity Proofs &amp;amp; Categories&lt;br&gt;• &lt;b&gt;Generated Letters:&lt;/b&gt; Official Admission Letters" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=left;spacingLeft=12;spacingRight=10;spacingTop=14;spacingBottom=6;fontSize=10.5;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;" vertex="1" parent="box_l4">
