  <mxCell id="cli_mob" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Applicant Mobile App&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #16a34a;&quot;&gt;(Android &amp;amp; iOS / Cross-Platform)&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 5px 0; border: 0; border-top: 1px solid #4ade80;&quot;&gt;• Real-Time Application Status Alerts&lt;br&gt;• Instant Push Notifications &amp;amp; Reminders&lt;br&gt;• Quick Document Scanning &amp;amp; Upload&lt;br&gt;• Payment Receipt &amp;amp; Status Verification" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=12;spacingRight=10;spacingTop=6;spacingBottom=6;fontSize=11;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=1.5;" vertex="1" parent="box_l1">
