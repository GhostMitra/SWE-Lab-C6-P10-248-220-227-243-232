  <mxCell id="edge_waf" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;DNS &amp;amp; Cloud Security&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9.5px; color: #ea580c;&quot;&gt;(Cloudflare WAF)&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 4px 0; border: 0; border-top: 1px solid #fb923c;&quot;&gt;• DDoS Mitigation &amp;amp; Bot Defense&lt;br&gt;• Edge SSL / TLS 1.3 Termination&lt;br&gt;• Static Asset Caching (CDN Acceleration)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingRight=10;spacingTop=6;spacingBottom=6;fontSize=10.5;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;" vertex="1" parent="box_l2">
