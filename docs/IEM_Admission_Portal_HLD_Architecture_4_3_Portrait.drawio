  <mxCell id="data_rdbms" value="&lt;div style=&quot;text-align: center;&quot;&gt;&lt;b&gt;Primary Relational DB&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px; color: #1d4ed8;&quot;&gt;(PostgreSQL / ACID Compliant)&lt;/font&gt;&lt;/div&gt;&lt;hr style=&quot;margin: 5px 0; border: 0; border-top: 1px solid #60a5fa;&quot;&gt;• &lt;b&gt;Users Table:&lt;/b&gt; Logins, Hashed Passwords, Roles&lt;br&gt;• &lt;b&gt;Applications Table:&lt;/b&gt; Personal &amp;amp; Academic Data&lt;br&gt;• &lt;b&gt;Payments Table:&lt;/b&gt; Txn IDs, Invoices &amp;amp; Status&lt;br&gt;• &lt;b&gt;Audit Trail:&lt;/b&gt; Officer Review Decisions &amp;amp; Logs" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;align=left;spacingLeft=12;spacingRight=10;spacingTop=14;spacingBottom=6;fontSize=10.5;fillColor=#eff6ff;strokeColor=#1d4ed8;strokeWidth=1.5;" vertex="1" parent="box_l4">
