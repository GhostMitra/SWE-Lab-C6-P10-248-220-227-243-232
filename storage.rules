rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Academic documents bucket
    match /academic-docs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Candidate media bucket
    match /candidate-media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Verification certificates bucket
    match /verification-certs/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    // Generated official admission letters
    match /generated-letters/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
